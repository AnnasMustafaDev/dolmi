# Copy this file to ".env" and fill in your own values. ".env" is gitignored.
#
# Optional feature unlock — a salted PBKDF2-HMAC-SHA256 password hash. The plaintext
# password is never stored in the code or this repo. Leave empty to disable.
#
# Generate the values for your own password with:
#   python -c "import os,hashlib;s=os.urandom(16);h=hashlib.pbkdf2_hmac('sha256',b'YOUR_PASSWORD',s,200000);print('DOLMI_PRO_SALT='+s.hex());print('DOLMI_PRO_HASH='+h.hex())"
DOLMI_PRO_SALT=
DOLMI_PRO_HASH=
